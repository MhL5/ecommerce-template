// use prisma-8

// Data contract for the shop. Edit this file, then run `pnpm db:emit` to
// regenerate `contract.json` / `contract.d.ts` next to it.
//
// Column and table names stay snake_case in Postgres (`@map` / `@@map`);
// fields are camelCase in TypeScript. Money is always integer cents.
//
// See docs/adr/0001-product-variants-and-attributes.md for the catalog model.

types {
  /// Primary key for domain tables (auth tables use Better Auth's text ids).
  Id = Uuid @default(sql`gen_random_uuid()`)
}

model mixin Timestamps {
  createdAt temporal.CreatedAtJsDate @default(now()) @map("created_at")
  updatedAt temporal.UpdatedAtJsDate @default(now()) @map("updated_at")
}

model mixin CreatedAt {
  createdAt temporal.CreatedAtJsDate @default(now()) @map("created_at")
}

// ---------------------------------------------------------------------------
// Auth
//
// Shaped to match Better Auth's core schema (plus the `admin` plugin fields)
// so its adapter can use them as-is. Keep column names in sync with
// `npx @better-auth/cli generate` when Better Auth is added.
// ---------------------------------------------------------------------------

model User {
  id                  String             @id
  name                String
  email               String             @unique
  emailVerified       Boolean            @default(false) @map("email_verified")
  image               String?
  // Better Auth admin plugin. Configure it with `defaultRole: "customer"`.
  role                String             @default("customer")
  banned              Boolean            @default(false)
  banReason           String?            @map("ban_reason")
  banExpires          TimestamptzJsDate? @map("ban_expires")
  sessions            Session[]
  accounts            Account[]
  addresses           Address[]
  cart                Cart?
  wishlist            WishlistItem[]
  orders              Order[]
  reviews             Review[]
  +Timestamps

  @@map("user")
}

model Session {
  id             String            @id
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String            @unique
  expiresAt      TimestamptzJsDate @map("expires_at")
  ipAddress      String?           @map("ip_address")
  userAgent      String?           @map("user_agent")
  // Better Auth admin plugin.
  impersonatedBy String?           @map("impersonated_by")
  +Timestamps

  @@index([userId], map: "session_user_id_idx")
  @@map("session")
}

model Account {
  id                    String             @id
  userId                String             @map("user_id")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String             @map("account_id")
  providerId            String             @map("provider_id")
  accessToken           String?            @map("access_token")
  refreshToken          String?            @map("refresh_token")
  idToken               String?            @map("id_token")
  accessTokenExpiresAt  TimestamptzJsDate? @map("access_token_expires_at")
  refreshTokenExpiresAt TimestamptzJsDate? @map("refresh_token_expires_at")
  scope                 String?
  /// Hashed by Better Auth for the email/password provider.
  password              String?
  +Timestamps

  @@index([userId], map: "account_user_id_idx")
  @@map("account")
}

model Verification {
  id         String            @id
  identifier String
  value      String
  expiresAt  TimestamptzJsDate @map("expires_at")
  +Timestamps

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Catalog: categories, brands and products.
//
// A product is the thing a customer browses; a variant is the thing they buy.
// Products declare options (Color, Size, …) with values (Red, XL, …) and every
// sellable combination is a variant with its own SKU, price, stock and images.
// A product without options still has exactly one default variant, so prices
// and stock always live on `product_variant`.
// ---------------------------------------------------------------------------

enum ProductStatus {
  @@type("pg/text@1")
  draft    = "draft"
  active   = "active"
  archived = "archived"
}

model Category {
  id          Id      @id
  /// Parent category for nesting, e.g. Clothing → Shirts.
  parentId    Uuid?   @map("parent_id")
  parent      Category? @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  slug        String  @unique
  name        String
  description String?
  image       String?
  position    Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")
  children    Category[]          @relation("CategoryParent")
  products    Product[]
  /// Join rows; each carries its `attribute`.
  attributes  CategoryAttribute[]
  +Timestamps

  @@index([parentId], map: "category_parent_id_idx")
  @@map("category")
}

model Brand {
  id          Id      @id
  slug        String  @unique
  name        String
  description String?
  logo        String?
  products    Product[]
  +Timestamps

  @@map("brand")
}

model Product {
  id             Id                 @id
  slug           String             @unique
  name           String
  brandId        Uuid?              @map("brand_id")
  brand          Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId     Uuid?              @map("category_id")
  category       Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description    String             @default("")
  /// Short selling points shown above the fold.
  highlights     String[]           @default(sql`'{}'`)
  tags           String[]           @default(sql`'{}'`)
  status         ProductStatus      @default(draft)
  featured       Boolean            @default(false)
  /// Cached from published reviews so listings can sort without a join.
  ratingAverage  Numeric(3, 2)      @default(0) @map("rating_average")
  reviewCount    Int                @default(0) @map("review_count")
  seoTitle       String?            @map("seo_title")
  seoDescription String?            @map("seo_description")
  /// Escape hatch for data that doesn't deserve a column or attribute.
  metadata       Jsonb              @default(sql`'{}'::jsonb`)
  publishedAt    TimestamptzJsDate? @map("published_at")
  options         ProductOption[]
  variants        ProductVariant[]
  images          ProductImage[]
  attributeValues ProductAttributeValue[]
  reviews         Review[]
  +Timestamps

  @@index([categoryId], map: "product_category_id_idx")
  @@index([brandId], map: "product_brand_id_idx")
  @@index([status], map: "product_status_idx")
  @@map("product")
}

/// An axis a product varies on, e.g. "Color" or "Size".
model ProductOption {
  id        Id      @id
  productId Uuid    @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int     @default(0)
  values    ProductOptionValue[]

  @@unique([productId, name], map: "product_option_product_name_uq")
  @@map("product_option")
}

/// One choice on an option, e.g. "Red" for Color.
model ProductOptionValue {
  id       Id            @id
  optionId Uuid          @map("option_id")
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  /// Hex colour or image URL for swatch pickers.
  swatch   String?
  position Int           @default(0)

  @@unique([optionId, value], map: "product_option_value_option_value_uq")
  // Target for the composite FK that keeps a variant's value on the right option.
  @@unique([optionId, id], map: "product_option_value_option_id_uq")
  @@map("product_option_value")
}

/// A sellable combination of option values (or the single default variant).
model ProductVariant {
  id             Id      @id
  productId      Uuid    @map("product_id")
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String? @unique
  barcode        String?
  /// Display name built from the option values, e.g. "Red / XL".
  title          String  @default("")
  /// Price in integer cents.
  price          Int
  /// Original price in cents when the variant is on sale.
  compareAtPrice Int?    @map("compare_at_price")
  /// What the shop paid, in cents, for margin reports.
  costPrice      Int?    @map("cost_price")
  stock          Int     @default(0)
  trackInventory Boolean @default(true) @map("track_inventory")
  allowBackorder Boolean @default(false) @map("allow_backorder")
  weightGrams    Int?    @map("weight_grams")
  isDefault      Boolean @default(false) @map("is_default")
  isActive       Boolean @default(true) @map("is_active")
  position       Int     @default(0)
  optionValues    ProductVariantOptionValue[]
  images          ProductImage[]
  attributeValues ProductAttributeValue[]
  +Timestamps

  @@index([productId], map: "product_variant_product_id_idx")
  @@index([productId], where: sql`is_default`, unique: true, name: "product_variant_one_default_uq")
  @@unique([productId, id], map: "product_variant_product_id_uq")
  @@check(expression: sql`price >= 0`, name: "product_variant_price_ck")
  @@check(expression: sql`compare_at_price is null or compare_at_price > price`, name: "product_variant_compare_at_price_ck")
  @@map("product_variant")
}

/// Which value a variant has for each option (one value per option).
model ProductVariantOptionValue {
  variantId     Uuid               @map("variant_id")
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId      Uuid               @map("option_id")
  option        ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionValueId Uuid               @map("option_value_id")
  value         ProductOptionValue @relation(fields: [optionId, optionValueId], references: [optionId, id], onDelete: Cascade, map: "product_variant_option_value_value_fk")

  @@id([variantId, optionId])
  @@index([optionValueId], map: "product_variant_option_value_value_idx")
  @@map("product_variant_option_value")
}

/// Product gallery. Images with a `variantId` show when that variant is picked.
model ProductImage {
  id        Id              @id
  productId Uuid            @map("product_id")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Uuid?           @map("variant_id")
  variant   ProductVariant? @relation(fields: [productId, variantId], references: [productId, id], onDelete: Cascade, map: "product_image_variant_fk")
  url       String
  alt       String          @default("")
  position  Int             @default(0)
  +Timestamps

  @@index([productId], map: "product_image_product_id_idx")
  @@map("product_image")
}

// ---------------------------------------------------------------------------
// Attributes: descriptive facts about a product that don't create variants,
// e.g. Material, Fabric weight, Wattage, Water resistance.
//
// An attribute is defined once (with a type and optional unit) and reused
// across products, so the shop can filter on it ("Material: Wool") and the
// admin can offer a consistent picker. Categories can suggest attributes.
// ---------------------------------------------------------------------------

/// - `text`: free text ("Hand wash only")
/// - `number`: numeric value, shown with `unit` ("254" g)
/// - `boolean`: yes / no ("Waterproof")
/// - `select`: one of `attribute_option` ("Material: Wool")
/// - `multiselect`: several of `attribute_option` ("Features: GPS, NFC")
enum AttributeType {
  @@type("pg/text@1")
  text        = "text"
  number      = "number"
  boolean     = "boolean"
  select      = "select"
  multiselect = "multiselect"
}

model Attribute {
  id           Id            @id
  slug         String        @unique
  name         String
  description  String?
  type         AttributeType @default(text)
  /// Shown after number values, e.g. "g", "mAh", "cm".
  unit         String?
  /// Show as a facet on product listings.
  isFilterable Boolean       @default(false) @map("is_filterable")
  position     Int           @default(0)
  options      AttributeOption[]
  /// Join rows; each carries its `category`.
  categories   CategoryAttribute[]
  +Timestamps

  @@map("attribute")
}

/// Allowed values for `select` / `multiselect` attributes.
model AttributeOption {
  id          Id        @id
  attributeId Uuid      @map("attribute_id")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  position    Int       @default(0)

  @@unique([attributeId, value], map: "attribute_option_attribute_value_uq")
  // Target for the composite FK that keeps a value's option on its attribute.
  @@unique([attributeId, id], map: "attribute_option_attribute_id_uq")
  @@map("attribute_option")
}

/// Attributes a category suggests (or requires) for its products.
model CategoryAttribute {
  categoryId  Uuid      @map("category_id")
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId Uuid      @map("attribute_id")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  isRequired  Boolean   @default(false) @map("is_required")
  position    Int       @default(0)

  @@id([categoryId, attributeId])
  @@map("category_attribute")
}

/// An attribute value on a product, or on one variant when `variantId` is set.
/// Exactly one `value*` / `optionId` column is filled, matching the attribute
/// type. `multiselect` attributes get one row per chosen option.
model ProductAttributeValue {
  id           Id               @id
  productId    Uuid             @map("product_id")
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    Uuid?            @map("variant_id")
  variant      ProductVariant?  @relation(fields: [productId, variantId], references: [productId, id], onDelete: Cascade, map: "product_attribute_value_variant_fk")
  attributeId  Uuid             @map("attribute_id")
  attribute    Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueText    String?          @map("value_text")
  valueNumber  Numeric?         @map("value_number")
  valueBoolean Boolean?         @map("value_boolean")
  optionId     Uuid?            @map("option_id")
  option       AttributeOption? @relation(fields: [attributeId, optionId], references: [attributeId, id], onDelete: Cascade, map: "product_attribute_value_option_fk")
  position     Int              @default(0)

  @@index([productId], map: "product_attribute_value_product_id_idx")
  // Facet filtering: "products with Material = Wool" / "Weight < 300".
  @@index([attributeId, optionId], map: "product_attribute_value_option_idx")
  @@index([attributeId, valueNumber], map: "product_attribute_value_number_idx")
  // One row per (product, variant, attribute, option), treating NULLs as equal.
  @@index(expression: sql`product_id, coalesce(variant_id, '00000000-0000-0000-0000-000000000000'::uuid), attribute_id, coalesce(option_id, '00000000-0000-0000-0000-000000000000'::uuid)`, unique: true, name: "product_attribute_value_uq")
  @@check(expression: sql`num_nonnulls(value_text, value_number, value_boolean, option_id) = 1`, name: "product_attribute_value_one_value_ck")
  @@map("product_attribute_value")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

enum ReviewStatus {
  @@type("pg/text@1")
  pending   = "pending"
  published = "published"
  rejected  = "rejected"
}

model Review {
  id                 Id           @id
  productId          Uuid         @map("product_id")
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// `null` once the author's account is deleted; `authorName` stays.
  userId             String?      @map("user_id")
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName         String       @map("author_name")
  rating             SmallInt
  title              String
  body               String
  status             ReviewStatus @default(published)
  /// The author bought this product in a delivered order.
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  +Timestamps

  @@index([productId, status], map: "review_product_id_idx")
  @@unique([productId, userId], map: "review_product_user_uq")
  @@check(expression: sql`rating between 1 and 5`, name: "review_rating_ck")
  @@map("review")
}

// ---------------------------------------------------------------------------
// Checkout configuration: discount codes and shipping methods.
// ---------------------------------------------------------------------------

/// - `percent`: `value` is a percentage of the subtotal (10 = 10%)
/// - `fixed`: `value` is cents off the subtotal
/// - `free_shipping`: shipping costs nothing; `value` is ignored
enum DiscountKind {
  @@type("pg/text@1")
  percent       = "percent"
  fixed         = "fixed"
  free_shipping = "free_shipping"
}

model Discount {
  id                    Id                 @id
  /// Stored upper-case; match codes case-insensitively.
  code                  String             @unique
  description           String             @default("")
  kind                  DiscountKind
  value                 Int                @default(0)
  /// Minimum subtotal in cents for the code to apply.
  minSubtotal           Int?               @map("min_subtotal")
  startsAt              TimestamptzJsDate? @map("starts_at")
  endsAt                TimestamptzJsDate? @map("ends_at")
  /// Total redemptions allowed across all customers.
  usageLimit            Int?               @map("usage_limit")
  usageLimitPerCustomer Int?               @map("usage_limit_per_customer")
  /// Cached count of `discount_redemption` rows.
  usedCount             Int                @default(0) @map("used_count")
  isActive              Boolean            @default(true) @map("is_active")
  redemptions           DiscountRedemption[]
  +Timestamps

  @@check(expression: sql`value >= 0`, name: "discount_value_ck")
  @@check(expression: sql`kind <> 'percent' or value <= 100`, name: "discount_percent_ck")
  @@map("discount")
}

model ShippingMethod {
  id               Id      @id
  /// Stable key used in code, e.g. "standard" or "express".
  code             String  @unique
  name             String
  description      String?
  /// Price in integer cents.
  price            Int
  /// Subtotal in cents at or above which shipping is free.
  freeOverSubtotal Int?    @map("free_over_subtotal")
  minDeliveryDays  Int?    @map("min_delivery_days")
  maxDeliveryDays  Int?    @map("max_delivery_days")
  isActive         Boolean @default(true) @map("is_active")
  position         Int     @default(0)
  +Timestamps

  @@map("shipping_method")
}

// ---------------------------------------------------------------------------
// Customer: things a shopper keeps between visits — addresses, wishlist, cart.
// ---------------------------------------------------------------------------

model Address {
  id                Id      @id
  userId            String  @map("user_id")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional nickname, e.g. "Home" or "Work".
  label             String?
  firstName         String  @map("first_name")
  lastName          String  @map("last_name")
  company           String?
  address1          String
  address2          String?
  city              String
  region            String
  postalCode        String  @map("postal_code")
  /// ISO 3166-1 alpha-2, e.g. "US".
  country           Char(2)
  phone             String?
  isDefaultShipping Boolean @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean @default(false) @map("is_default_billing")
  +Timestamps

  @@index([userId], map: "address_user_id_idx")
  @@map("address")
}

model WishlistItem {
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Uuid    @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  +CreatedAt

  @@id([userId, productId])
  @@map("wishlist_item")
}

/// A signed-in user's cart, or a guest cart found by the `token` in a cookie.
/// Merge the guest cart into the user's cart on sign-in.
model Cart {
  id         Id                 @id
  userId     String?            @unique @map("user_id")
  user       User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String?            @unique
  discountId Uuid?              @map("discount_id")
  discount   Discount?          @relation(fields: [discountId], references: [id], onDelete: SetNull)
  /// Guest carts can be cleaned up after this.
  expiresAt  TimestamptzJsDate? @map("expires_at")
  items      CartItem[]
  +Timestamps

  @@check(expression: sql`user_id is not null or token is not null`, name: "cart_owner_ck")
  @@map("cart")
}

model CartItem {
  id        Id             @id
  cartId    Uuid           @map("cart_id")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Uuid           @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  +Timestamps

  @@unique([cartId, variantId], map: "cart_item_cart_variant_uq")
  @@check(expression: sql`quantity > 0`, name: "cart_item_quantity_ck")
  @@map("cart_item")
}

// ---------------------------------------------------------------------------
// Orders. Everything an order shows (names, options, prices, addresses) is
// copied onto it at checkout, so editing or deleting products, discounts or
// shipping methods never changes an old order.
// ---------------------------------------------------------------------------

/// Snapshot of an address at checkout.
type OrderAddress {
  firstName  String
  lastName   String
  company    String?
  address1   String
  address2   String?
  city       String
  region     String
  postalCode String
  country    String
  phone      String?
}

/// Snapshot of the option values on the variant that was bought.
type OrderItemOption {
  name  String
  value String
}

enum OrderStatus {
  @@type("pg/text@1")
  pending    = "pending"
  processing = "processing"
  shipped    = "shipped"
  delivered  = "delivered"
  cancelled  = "cancelled"
  refunded   = "refunded"
}

enum PaymentStatus {
  @@type("pg/text@1")
  pending            = "pending"
  authorized         = "authorized"
  paid               = "paid"
  failed             = "failed"
  refunded           = "refunded"
  partially_refunded = "partially_refunded"
}

model Order {
  id                 Id                 @id
  /// Human-friendly reference shown to customers, e.g. `NS-4F7K2Q`.
  number             String             @unique
  /// `null` for guest checkout (or once the account is deleted).
  userId             String?            @map("user_id")
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  email              String
  status             OrderStatus        @default(pending)
  paymentStatus      PaymentStatus      @default(pending) @map("payment_status")
  currency           Char(3)            @default("USD")
  // Totals in integer cents.
  subtotal           Int
  discountTotal      Int                @default(0) @map("discount_total")
  shippingTotal      Int                @default(0) @map("shipping_total")
  taxTotal           Int                @default(0) @map("tax_total")
  total              Int
  discountId         Uuid?              @map("discount_id")
  discount           Discount?          @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountCode       String?            @map("discount_code")
  shippingMethodId   Uuid?              @map("shipping_method_id")
  shippingMethod     ShippingMethod?    @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shippingMethodName String             @map("shipping_method_name")
  shippingAddress    OrderAddress       @map("shipping_address")
  /// `null` when billing matches shipping.
  billingAddress     OrderAddress?      @map("billing_address")
  customerNote       String?            @map("customer_note")
  cancelledAt        TimestamptzJsDate? @map("cancelled_at")
  items              OrderItem[]
  statusEvents       OrderStatusEvent[]
  payments           Payment[]
  +Timestamps

  @@index([userId], map: "order_user_id_idx")
  @@index([email], map: "order_email_idx")
  @@index([status], map: "order_status_idx")
  @@index([createdAt], map: "order_created_at_idx")
  @@map("order")
}

model OrderItem {
  id           Id                @id
  orderId      Uuid              @map("order_id")
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Uuid?             @map("product_id")
  product      Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    Uuid?             @map("variant_id")
  variant      ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String            @map("product_name")
  productSlug  String            @map("product_slug")
  brandName    String?           @map("brand_name")
  /// e.g. "Red / XL"; empty for products without options.
  variantTitle String            @default("") @map("variant_title")
  options      OrderItemOption[] @default(sql`'[]'::jsonb`)
  sku          String?
  image        String?
  /// Unit price in cents at checkout.
  unitPrice    Int               @map("unit_price")
  quantity     Int
  /// `unitPrice * quantity`, in cents.
  lineTotal    Int               @map("line_total")
  +CreatedAt

  @@index([orderId], map: "order_item_order_id_idx")
  @@index([variantId], map: "order_item_variant_id_idx")
  @@check(expression: sql`quantity > 0`, name: "order_item_quantity_ck")
  @@map("order_item")
}

/// Status timeline shown on the order page and in the admin.
model OrderStatusEvent {
  id      Id          @id
  orderId Uuid        @map("order_id")
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  OrderStatus
  note    String?
  /// Admin or customer who made the change; `null` for the system.
  actorId String?     @map("actor_id")
  actor   User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  +CreatedAt

  @@index([orderId], map: "order_status_event_order_id_idx")
  @@map("order_status_event")
}

/// A payment attempt or refund against an order, from any provider.
model Payment {
  id                Id            @id
  orderId           Uuid          @map("order_id")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// e.g. "mock", "stripe".
  provider          String
  /// The provider's id for this payment (charge / intent id).
  providerReference String?       @map("provider_reference")
  status            PaymentStatus @default(pending)
  /// Amount in cents.
  amount            Int
  refundedAmount    Int           @default(0) @map("refunded_amount")
  currency          Char(3)       @default("USD")
  cardBrand         String?       @map("card_brand")
  cardLast4         Char(4)?      @map("card_last4")
  failureReason     String?       @map("failure_reason")
  +Timestamps

  @@index([orderId], map: "payment_order_id_idx")
  @@index([provider, providerReference], map: "payment_provider_reference_idx")
  @@map("payment")
}

/// One use of a discount code, for usage limits and reporting.
model DiscountRedemption {
  id         Id       @id
  discountId Uuid     @map("discount_id")
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  orderId    Uuid     @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  /// Cents taken off the order.
  amount     Int
  +CreatedAt

  @@unique([discountId, orderId], map: "discount_redemption_discount_order_uq")
  @@index([discountId, email], map: "discount_redemption_discount_email_idx")
  @@map("discount_redemption")
}
